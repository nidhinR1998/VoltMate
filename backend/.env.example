# ==========================================
# VoltMate Production / Development Config
# Zero-Cost Infrastructure Tech Stack
# ==========================================

# Core App Settings
APP_NAME=VoltMate
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=voltmate_super_secret_jwt_encryption_key_production_grade_32char
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=voltmate_admin
POSTGRES_PASSWORD=voltmate_secret_dev_pass_2026
POSTGRES_DB=voltmate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://voltmate_admin:voltmate_secret_dev_pass_2026@postgres:5432/voltmate

# Redis Cache & Locks
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Mosquitto MQTT & Smart Plug Relay
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=voltmate/plugs/

# Open-Source Routing Machine (OSRM) - Free Public Endpoint or Self-Hosted
OSRM_BASE_URL=https://router.project-osrm.org

# Map Vector Tile Services (Zero Cost)
OLA_MAPS_API_KEY=YOUR_FREE_OLA_MAPS_KEY_OR_FALLBACK
OPEN_FREE_MAP_URL=https://tiles.openfreemap.org/styles/dark

# Authentication (Google 1-Tap & SMTP Free Tiers)
GOOGLE_CLIENT_ID=voltmate-google-client-id-dev.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@voltmate.org
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=VoltMate Spark Security
SMTP_FROM_EMAIL=no-reply@voltmate.org

# India UPI Settlement Default VPA (Host fallback or platform default)
VOLTMATE_MERCHANT_VPA=voltmate.community@okaxis

