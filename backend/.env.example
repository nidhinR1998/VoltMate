# ==========================================
# VoltMate Back-End Environment Template
# Copy to .env and populate server-side values
# ==========================================

# Core App Settings
APP_NAME=
APP_ENV=
API_V1_PREFIX=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# Database (PostgreSQL Enterprise EDW)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=

# Redis Cache & Locks
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_URL=

# Mosquitto MQTT & Smart Plug Relay
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=
MQTT_TOPIC_PREFIX=

# Routing & Map Services
OSRM_BASE_URL=
OLA_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
OPEN_FREE_MAP_URL=

# Google Sign-In OAuth 2.0 (Web Client ID used as serverClientId + Android Client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXTRA_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Razorpay Payments (Server-Side Key ID, Secret & Webhook Secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP for Transactional OTP Emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# Default Platform Merchant UPI VPA & CORS
VOLTMATE_MERCHANT_VPA=
CORS_ORIGINS=
