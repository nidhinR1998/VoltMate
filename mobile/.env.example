EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Native Google Maps SDK Keys (100% Free & Unlimited on Android/iOS Mobile SDK when Cloud Map IDs are omitted)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=YOUR_ANDROID_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=YOUR_IOS_GOOGLE_MAPS_API_KEY

# Zero-Cost Routing & Places Autocomplete (Ola Maps Free Tier -> OSRM & Photon Komoot Auto-Fallback)
EXPO_PUBLIC_OLA_MAPS_API_KEY=
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org
EXPO_PUBLIC_PHOTON_BASE_URL=https://photon.komoot.io
